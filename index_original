<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>현장 사진 증거표시</title>

<style>
body{margin:0;font-family:system-ui;background:#f2f2f2}
header{
  background:#111;color:#fff;padding:8px;
  display:flex;gap:6px;align-items:center;flex-wrap:wrap
}
#container{position:relative;width:100%}
#photo{width:100%;display:block}
canvas{position:absolute;left:0;top:0}
.mark{
  position:absolute;background:#fff;border:1px solid #aaa;
  border-radius:6px;padding:4px;font-size:13px;width:160px
}
.mark b{display:block;margin-bottom:2px}
.mark input{width:100%;border:none;outline:none}
  
.mark input {
  position: absolute;
  left: -9999px; /* 화면 밖으로 이동 */
  top: -9999px;
}
  
button{padding:4px 8px;font-size:13px}
</style>
</head>

<body>

<header>
  <input type="file" id="file" accept="image/*">
  <select id="color">
    <option value="red">🔴 Red</option>
    <option value="blue">🔵 Blue</option>
    <option value="green">🟢 Green</option>
  </select>

  원크기
  <input type="range" id="radius" min="15" max="200" value="80">

  선굵기
  <input type="range" id="line" min="2" max="12" value="4">

  문자크기
  <input type="range" id="fontSize" min="8" max="80" value="13">

  <button onclick="saveImage()">증거사진 저장</button>
  <button onclick="deleteSelected()">선택 원 삭제</button>
</header>

<div id="container">
  <img id="photo">
  <canvas id="overlay"></canvas>
</div>

<script>
const img = document.getElementById("photo");
const canvas = document.getElementById("overlay");
const ctx = canvas.getContext("2d");

const container = document.getElementById("container");
const colorSel = document.getElementById("color");
const radiusInput = document.getElementById("radius");
const lineInput = document.getElementById("line");
const fontSizeInput = document.getElementById("fontSize"); // 여기

/* 상태 변수 */
const marks = [];
let selectedIndex = null;
let evidenceNo = 1;

let startX = 0, startY = 0;
let drawing = false;

let dragging = false;
let dragOffsetX = 0;
let dragOffsetY = 0;

/* 좌표 계산 */
function getPos(e){
  const rect = canvas.getBoundingClientRect();
  const clientX = e.touches ? e.touches[0].clientX : e.clientX;
  const clientY = e.touches ? e.touches[0].clientY : e.clientY;
  return {
    x: clientX - rect.left,
    y: clientY - rect.top
  };
}

/* 원 히트 테스트 */
function hitTest(x, y, m){
  const dx = x - m.x;
  const dy = y - m.y;
  return Math.sqrt(dx*dx + dy*dy) <= m.r;
}

/* ===== START (선택 or 새 원 준비) ===== */
canvas.addEventListener("mousedown", startAction);
canvas.addEventListener("touchstart", startAction);

canvas.addEventListener("dblclick", (e)=>{
    if(selectedIndex === null) return;
    const text = prompt("박스에 넣을 텍스트를 입력하세요:", marks[selectedIndex].text || "");
    if(text !== null){
        marks[selectedIndex].text = text;
        redraw();
    }
});

function startAction(e){
  e.preventDefault();

  const {x, y} = getPos(e);
  selectedIndex = null;
  dragging = false;
  drawing = false;

  // 기존 원 선택 (위에 있는 것 우선)
  for(let i = marks.length - 1; i >= 0; i--){
    if(hitTest(x, y, marks[i])){
      selectedIndex = i;
      dragging = true;

      dragOffsetX = x - marks[i].x;
      dragOffsetY = y - marks[i].y;

      radiusInput.value = marks[i].r;
      lineInput.value   = marks[i].line;

      redraw();
      return;
    }
  }

  // 새 원 생성 준비
  startX = x;
  startY = y;
  drawing = true;
}

/* ===== MOVE (드래그 이동) ===== */
canvas.addEventListener("mousemove", moveAction);
canvas.addEventListener("touchmove", moveAction);

function moveAction(e){
  if(!dragging || selectedIndex === null) return;
  e.preventDefault();

  const {x, y} = getPos(e);
  const m = marks[selectedIndex];

  m.x = x - dragOffsetX;
  m.y = y - dragOffsetY;

  const box = document.querySelectorAll(".mark")[selectedIndex];
  if(box){
    const fontSize = parseInt(fontSizeInput.value);
    const textMetrics = ctx.measureText(box.querySelector("input").value);
    const textWidth = textMetrics.width + 16; // 여백
    box.style.width = textWidth + "px";
    box.style.top = (marks[selectedIndex].y + marks[selectedIndex].r + 6) + "px";
  }

  redraw();
}

/* ===== END (드래그 종료 + 새 원 생성) ===== */
canvas.addEventListener("mouseup", endAction);
canvas.addEventListener("touchend", endAction);

function endAction(){
  if(dragging){
    dragging = false;
    return;
  }

  if(!drawing) return;
  drawing = false;

  const r  = parseInt(radiusInput.value);
  const lw = parseInt(lineInput.value);

  marks.push({
    x: startX,
    y: startY,
    r,
    line: lw,
    color: colorSel.value,
    no: evidenceNo
  });

  selectedIndex = marks.length - 1;

  const box = document.createElement("div");
  box.className = "mark";
  box.style.left = (startX - 80) + "px";
  box.style.top  = (startY + r + 6) + "px";
  box.innerHTML = `<input placeholder="내용 입력">`;
  container.appendChild(box);

  evidenceNo++;
  redraw();
}

/* 이미지 로드 */
document.getElementById("file").addEventListener("change", e=>{
  const f = e.target.files[0];
  if(!f) return;
  img.src = URL.createObjectURL(f);
});

img.onload = ()=>{
  canvas.width = img.clientWidth;
  canvas.height = img.clientHeight;
};

/* 삭제 */
function deleteSelected(){
  if(selectedIndex === null){
    alert("삭제할 증거를 먼저 선택하세요.");
    return;
  }

  document.querySelectorAll(".mark")[selectedIndex]?.remove();
  marks.splice(selectedIndex, 1);

  marks.forEach((m,i)=>m.no=i+1);
  evidenceNo = marks.length + 1;

  document.querySelectorAll(".mark b").forEach((b,i)=>{
    b.textContent = `증거 ${i+1}`;
  });

  selectedIndex = null;
  redraw();
}


/* ===== 박스 크기 조정 함수 ===== */
function updateBoxSize(i){
  const box = document.querySelectorAll(".mark")[i];
  if(!box) return;

  const input = box.querySelector("input");
  if(!input) return;

  // 글자 크기
  const fontSize = parseInt(fontSizeInput.value);

  // 박스 크기 계산
  ctx.font = `${fontSize}px sans-serif`;
  const textMetrics = ctx.measureText(input.value);
  const textWidth = textMetrics.width + 16; // 좌우 여백
  const textHeight = fontSize + 8;          // 상하 여백

  // 박스 크기 및 글꼴 크기 적용
  box.style.width = textWidth + "px";
  box.style.height = textHeight + "px";
  box.style.top = (marks[i].y + marks[i].r + 6) + "px";
  box.style.left = (marks[i].x - textWidth / 2) + "px";
  input.style.fontSize = fontSize + "px";   // ✅ 입력창 글자 크기 변경
}


document.querySelectorAll(".mark input").forEach((input, i)=>{
  input.addEventListener("input", ()=>{
    updateBoxSize(i);
    redraw();
  });
});

fontSizeInput.addEventListener("input", ()=>{
  if(selectedIndex !== null){
    updateBoxSize(selectedIndex);
    redraw();
  }
});


  
/* 다시 그리기 */
function redraw() {
  // 1. 캔버스 초기화
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // 2. 원본 이미지 그리기
  ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

  const sx = canvas.width / img.clientWidth;
  const sy = canvas.height / img.clientHeight;

  marks.forEach((m, i) => {
    // ===== 원 그리기 =====
    ctx.beginPath();
    ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
    ctx.strokeStyle = m.color;
    ctx.lineWidth = m.line * sx;

    if (i === selectedIndex) ctx.setLineDash([6, 4]);
    else ctx.setLineDash([]);

    ctx.stroke();
    ctx.setLineDash([]);

    // ===== 원 번호 그리기 =====
    ctx.fillStyle = m.color;
    ctx.font = "bold 16px sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(m.no, m.x, m.y);

    // ===== 박스 텍스트 그리기 (캔버스 전용) =====
    const box = document.querySelectorAll(".mark")[i];
    if (!box) return;

    const input = marks[i].text || box.querySelector("input").value;
    if(!input) return;

    // 글자 크기 계산
    const fontSize = parseInt(fontSizeInput.value);
    ctx.font = `${fontSize * sy}px sans-serif`;

    // 텍스트 크기에 따라 박스 크기 계산
    const textMetrics = ctx.measureText(input);
    const textWidth = textMetrics.width + 16 * sy; // 좌우 여백
    const textHeight = fontSize * sy + 8 * sy;     // 상하 여백

    const boxX = m.x - textWidth / 2;
    const boxY = m.y + m.r + 6;
    const boxW = textWidth;
    const boxH = textHeight;

    // 박스 배경
    ctx.fillStyle = "#ffffff";
    ctx.strokeStyle = "#aaaaaa";
    ctx.lineWidth = 2 * sx;
    ctx.fillRect(boxX, boxY, boxW, boxH);
    ctx.strokeRect(boxX, boxY, boxW, boxH);

    // 박스 텍스트
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillStyle = "#000";
    ctx.fillText(input, boxX + boxW / 2, boxY + boxH / 2);

    // HTML 박스는 화면에서 숨기기 (입력용)
    box.style.display = "none";

    // 정렬 초기화
    ctx.textAlign = "left";
    ctx.textBaseline = "alphabetic";
  });
}


/* === 슬라이더 이벤트 등록 === */
radiusInput.addEventListener("input", ()=>{
  if(selectedIndex === null) return;
  marks[selectedIndex].r = parseInt(radiusInput.value);
  redraw();
});

lineInput.addEventListener("input", ()=>{
  if(selectedIndex === null) return;
  marks[selectedIndex].line = parseInt(lineInput.value);
  redraw();
});

fontSizeInput.addEventListener("input", ()=>{
  if(selectedIndex === null) return;
  redraw();  // 글자 크기는 marks 배열에서 참조하므로 바로 redraw 호출
});

/* ===== 증거사진 저장 함수 ===== */
function saveImage() {
  const a = document.createElement("a");
  a.href = canvas.toDataURL("image/jpeg", 0.95);
  a.download = "증거사진.jpg";
  a.click();
}
  
</script>

</body>
</html>
